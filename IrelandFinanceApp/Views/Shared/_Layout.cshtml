@using System.Globalization
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower();
    var isPt = currentCulture.Equals("pt", StringComparison.OrdinalIgnoreCase);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ireland Finance</title>

    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-width: 260px;
            --emerald-primary: #10b981;
            --emerald-hover: #059669;
            --emerald-subtle: rgba(16, 185, 129, 0.12);
            --deep-slate: #0b1120;
            --sidebar-bg: #0f172a;
            --sidebar-border: #1e293b;
            --content-bg: #f8fafc;
        }

        body {
            background-color: var(--content-bg);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #334155;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Sidebar Container */
        .app-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            display: flex;
            flex-direction: column;
            z-index: 1040;
            transition: transform 0.25s ease-in-out;
        }

        .sidebar-brand {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--sidebar-border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: #ffffff;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #10b981, #047857);
            color: #ffffff;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }

        .sidebar-menu {
            padding: 1rem 0.75rem;
            flex-grow: 1;
            overflow-y: auto;
        }

        .nav-category {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            font-weight: 700;
            padding: 0.75rem 0.75rem 0.35rem 0.75rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.85rem;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.92rem;
            transition: all 0.15s ease-in-out;
            margin-bottom: 2px;
        }

        .sidebar-link i {
            font-size: 1.15rem;
        }

        .sidebar-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .sidebar-link.active {
            color: #ffffff;
            background-color: var(--emerald-primary);
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
        }

        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid var(--sidebar-border);
            background-color: rgba(0, 0, 0, 0.15);
        }

        /* Layout Main Area */
        .app-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.25s ease-in-out;
        }

        .top-navbar {
            height: 64px;
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .content-area {
            flex-grow: 1;
            padding: 1.75rem;
        }

        .btn-emerald {
            background-color: var(--emerald-primary);
            color: #ffffff;
            border: none;
        }

        .btn-emerald:hover {
            background-color: var(--emerald-hover);
            color: #ffffff;
        }

        /* Backdrop para Mobile */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(15, 23, 42, 0.6);
            z-index: 1030;
            backdrop-filter: blur(2px);
        }

        /* Responsividade Mobile */
        @@media (max-width: 991.98px) {
            .app-sidebar {
                transform: translateX(-100%);
            }
            .app-sidebar.show {
                transform: translateX(0);
            }
            .sidebar-backdrop.show {
                display: block;
            }
            .app-wrapper {
                margin-left: 0;
            }
            .top-navbar {
                padding: 0 1rem;
            }
            .content-area {
                padding: 1.25rem 0.85rem;
            }
        }
    </style>
</head>
<body>

    <!-- Backdrop Mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <!-- Sidebar Lateral -->
    <aside class="app-sidebar" id="appSidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">
                <i class="bi bi-wallet2"></i>
            </span>
            <div class="d-flex flex-column leading-tight">
                <span>Ireland Finance</span>
                <span class="text-secondary" style="font-size: 0.68rem; font-weight: 500; letter-spacing: 0.02em;">CASHFLOW & RUNWAY</span>
            </div>
        </a>

        <div class="sidebar-menu">
            <div class="nav-category">@(isPt ? "Visão Geral" : "Overview")</div>
            <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid-1x2"></i>
                <span>@(isPt ? "Dashboard" : "Dashboard")</span>
            </a>

            <div class="nav-category mt-2">@(isPt ? "Gestão Financeira" : "Financials")</div>
            <a class="sidebar-link @(currentController == "Transactions" ? "active" : "")" asp-controller="Transactions" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i>
                <span>@(isPt ? "Lançamentos" : "Transactions")</span>
            </a>
            <a class="sidebar-link @(currentController == "CreditCards" ? "active" : "")" asp-controller="CreditCards" asp-action="Index">
                <i class="bi bi-credit-card-2-front"></i>
                <span>@(isPt ? "Cartões de Crédito" : "Credit Cards")</span>
            </a>
            <a class="sidebar-link @(currentController == "SavingsGoals" ? "active" : "")" asp-controller="SavingsGoals" asp-action="Index">
                <i class="bi bi-piggy-bank"></i>
                <span>@(isPt ? "Metas & Reserva" : "Savings Goals")</span>
            </a>
            <a class="sidebar-link @(currentController == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                <i class="bi bi-tags"></i>
                <span>@(isPt ? "Categorias" : "Categories")</span>
            </a>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center border border-secondary border-opacity-50" style="width: 34px; height: 34px; font-size: 0.85rem; flex-shrink: 0;">
                            <i class="bi bi-person-fill text-emerald"></i>
                        </div>
                        <div class="overflow-hidden text-nowrap">
                            <div class="text-white small fw-bold text-truncate" style="max-width: 130px;">
                                @(User.Identity?.Name?.Split('@')[0] ?? "User")
                            </div>
                            <div class="text-muted" style="font-size: 0.7rem;">PRO Account</div>
                        </div>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                        <button type="submit" class="btn btn-link text-secondary p-1" title="@(isPt ? "Sair" : "Sign Out")">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </aside>

    <!-- Conteúdo Principal e Topbar -->
    <div class="app-wrapper">
        <header class="top-navbar">
            <div class="d-flex align-items-center gap-2">
                <!-- Botão Toggle da Sidebar (Mobile) -->
                <button class="btn btn-light d-lg-none border-0 px-2 text-dark" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <span class="text-dark fw-bold fs-6 d-none d-sm-inline">
                    @ViewData["Title"]
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Seletor EN / PT -->
                <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border" role="group">
                    <form asp-controller="Home" asp-action="SetCulture" method="post" class="d-inline">
                        <input type="hidden" name="culture" value="en" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm rounded-pill px-2 fw-bold @(!isPt ? "btn-emerald shadow-sm text-white" : "btn-transparent text-muted border-0")" style="font-size: 0.72rem;">
                            EN
                        </button>
                    </form>
                    <form asp-controller="Home" asp-action="SetCulture" method="post" class="d-inline">
                        <input type="hidden" name="culture" value="pt" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm rounded-pill px-2 fw-bold @(isPt ? "btn-emerald shadow-sm text-white" : "btn-transparent text-muted border-0")" style="font-size: 0.72rem;">
                            PT
                        </button>
                    </form>
                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-sm btn-light border rounded-pill px-3 d-flex align-items-center gap-2 text-dark text-decoration-none">
                        <i class="bi bi-gear-fill text-muted"></i>
                        <span class="d-none d-md-inline">@(isPt ? "Configurações" : "Settings")</span>
                    </a>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-dark rounded-pill px-3" asp-area="Identity" asp-page="/Account/Login">
                            @(isPt ? "Entrar" : "Log In")
                        </a>
                        <a class="btn btn-sm btn-emerald rounded-pill px-3 shadow-sm" asp-area="Identity" asp-page="/Account/Register">
                            @(isPt ? "Registrar" : "Register")
                        </a>
                    </div>
                }
            </div>
        </header>

        <main role="main" class="content-area">
            @RenderBody()
        </main>

        <footer class="py-3 px-4 text-center text-muted small border-top bg-white">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.UtcNow.Year - Ireland Finance App</span>
                <span class="d-inline-flex align-items-center gap-1">
                    <i class="bi bi-shield-check text-emerald"></i>
                    @(isPt ? "Gestão Financeira Pessoal" : "Personal Cashflow & Runway")
                </span>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>