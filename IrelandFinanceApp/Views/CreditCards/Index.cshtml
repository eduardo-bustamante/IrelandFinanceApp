@model IEnumerable<IrelandFinanceApp.Models.CreditCard>
@using System.Globalization

@{
    ViewData["Title"] = "Cartões de Crédito";

    var cardsList = Model?.ToList() ?? new List<IrelandFinanceApp.Models.CreditCard>();

    // Totais gerais consolidados
    var totalLimiteGeral = cardsList.Sum(c => c.CreditLimit);
    var totalComprometidoGeral = cardsList.Sum(c => c.Transactions?.Where(t => !t.IsSettled && !t.IsInvoicePayment).Sum(t => t.Amount) ?? 0m);
    var totalDisponivelGeral = Math.Max(0, totalLimiteGeral - totalComprometidoGeral);
}

<div class="container-fluid px-0">
    <!-- Cabeçalho da Página -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-emerald-subtle text-emerald" style="background: rgba(16, 185, 129, 0.12); color: #059669;">
                    <i class="bi bi-credit-card-2-front fs-5"></i>
                </span>
                <h4 class="fw-bold text-dark mb-0">Cartões de Crédito</h4>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Acompanhe faturas futuras e limites comprometidos sem misturar com o saldo imediato da conta.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn text-white rounded-pill px-4 py-2 fw-semibold shadow-sm" style="background-color: #10b981;">
                <i class="bi bi-plus-lg me-1"></i> Novo Cartão
            </a>
        </div>
    </div>

    @if (!cardsList.Any())
    {
        <!-- Estado Vazio -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="mx-auto mb-3 text-secondary" style="font-size: 3rem;">
                <i class="bi bi-credit-card"></i>
            </div>
            <h5 class="fw-bold text-dark">Nenhum cartão cadastrado</h5>
            <p class="text-muted small mx-auto" style="max-width: 420px;">
                Cadastre seus cartões de crédito para ter previsão precisa de vencimentos, fechamento de faturas e limite disponível.
            </p>
            <div class="mt-2">
                <a asp-action="Create" class="btn text-white rounded-pill px-4 fw-semibold" style="background-color: #10b981;">
                    Cadastrar Meu Primeiro Cartão
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Cards Resumo Consolidado -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-semibold">Limite Total Consolidado</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">@totalLimiteGeral.ToString("C")</h4>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-semibold">Faturas Abertas (Geral)</span>
                    <h4 class="fw-bold text-danger mb-0 mt-1">@totalComprometidoGeral.ToString("C")</h4>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-semibold">Limite Disponível Geral</span>
                    <h4 class="fw-bold text-success mb-0 mt-1">@totalDisponivelGeral.ToString("C")</h4>
                </div>
            </div>
        </div>

        <!-- Grid de Cartões -->
        <div class="row g-4">
            @foreach (var card in cardsList)
            {
                // Soma das despesas não liquidadas do cartão
                var totalFaturasAbertas = card.Transactions?
                    .Where(t => !t.IsSettled && !t.IsInvoicePayment)
                    .Sum(t => t.Amount) ?? 0m;

                var limiteBase = card.CreditLimit > 0 ? card.CreditLimit : 1m;
                var percentualUso = Math.Min(100, Math.Round((totalFaturasAbertas / limiteBase) * 100m, 1));
                var disponivel = Math.Max(0, card.CreditLimit - totalFaturasAbertas);

                // Cor do gradiente do cartão
                var corCartao = string.IsNullOrWhiteSpace(card.ColorHex) ? "#10b981" : card.ColorHex;

                // Cor dinâmica da barra de progresso
                var corBarra = percentualUso >= 90 ? "#ef4444" : (percentualUso >= 70 ? "#f59e0b" : "#10b981");

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 d-flex flex-column justify-content-between">

                        <!-- Topo Visual do Cartão -->
                        <div>
                            <div class="p-3 text-white position-relative" style="background: linear-gradient(135deg, @corCartao, #0f172a); min-height: 155px;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="fw-bold fs-5 text-truncate" style="max-width: 80%;">@card.Name</span>
                                    <i class="bi bi-credit-card-2-front fs-4 opacity-75"></i>
                                </div>

                                <div class="mb-3">
                                    <span class="d-block small opacity-75" style="font-size: 0.75rem;">Limite Total</span>
                                    <span class="fs-4 fw-bold">@card.CreditLimit.ToString("C")</span>
                                </div>

                                <div class="d-flex justify-content-between small opacity-75 pt-2 border-top border-white border-opacity-25" style="font-size: 0.78rem;">
                                    <span>Fecha dia: <strong>@card.ClosingDay</strong></span>
                                    <span>Vence dia: <strong>@card.DueDay</strong></span>
                                </div>
                            </div>

                            <!-- Barra de Progresso do Limite -->
                            <div class="px-3 pt-3 pb-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-secondary" style="font-size: 0.74rem; font-weight: 600;">Uso do Limite</span>
                                    <span class="fw-bold" style="font-size: 0.74rem; color: @corBarra;">@percentualUso%</span>
                                </div>
                                <div class="progress" style="height: 7px; background-color: #f1f5f9; border-radius: 10px; overflow: hidden;">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @percentualUso.ToString("0.0", CultureInfo.InvariantCulture)%; background-color: @corBarra; transition: width 0.4s ease;"
                                         aria-valuenow="@percentualUso"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>

                            <!-- Valores de Fatura e Disponível -->
                            <div class="px-3 pt-2">
                                <div class="d-flex justify-content-between align-items-center py-1 small">
                                    <span class="text-muted">Faturas Abertas:</span>
                                    <span class="fw-bold text-danger">@totalFaturasAbertas.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-1 small">
                                    <span class="text-muted">Disponível:</span>
                                    <span class="fw-bold text-success">@disponivel.ToString("C")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ações Inferiores -->
                        <div class="p-3 pt-0 mt-3">
                            <div class="d-flex gap-2 pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@card.Id" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold py-1">
                                    <i class="bi bi-receipt me-1"></i> Ver Faturas
                                </a>
                                <a asp-action="Edit" asp-route-id="@card.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-2 d-flex align-items-center justify-content-center" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>