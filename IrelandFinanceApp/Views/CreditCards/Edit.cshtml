@model IrelandFinanceApp.Models.ViewModels.CreditCardCreateEditViewModel

@{
    var isPt = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("pt", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isPt ? "Editar Cartão" : "Edit Credit Card";
}

<div class="container py-4" style="max-width: 540px;">
    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 16px;">
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="fw-bold text-dark mb-0">@(isPt ? "Editar Cartão" : "Edit Credit Card")</h4>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold small text-dark">@(isPt ? "Nome do Cartão" : "Card Name")</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CreditLimit" class="form-label fw-semibold small text-dark">@(isPt ? "Limite de Crédito (€)" : "Credit Limit (€)")</label>
                <input asp-for="CreditLimit" type="number" step="0.01" min="0.01" class="form-control" required />
                <span asp-validation-for="CreditLimit" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="ClosingDay" class="form-label fw-semibold small text-dark">@(isPt ? "Dia Fechamento" : "Closing Day")</label>
                    <input asp-for="ClosingDay" type="number" min="1" max="31" class="form-control" required />
                </div>
                <div class="col-6">
                    <label asp-for="DueDay" class="form-label fw-semibold small text-dark">@(isPt ? "Dia Vencimento" : "Due Day")</label>
                    <input asp-for="DueDay" type="number" min="1" max="31" class="form-control" required />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ColorHex" class="form-label fw-semibold small text-dark">@(isPt ? "Cor do Cartão" : "Card Color")</label>
                <input asp-for="ColorHex" type="color" class="form-control form-control-color w-100" style="height: 42px;" />
            </div>

            <div class="d-flex justify-content-between pt-2 border-top">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteCardModal">
                    <i class="bi bi-trash"></i>
                </button>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">@(isPt ? "Cancelar" : "Cancel")</a>
                    <button type="submit" class="btn btn-emerald px-4 shadow-sm">@(isPt ? "Salvar" : "Save")</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Exclusão -->
<div class="modal fade" id="deleteCardModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-circle text-danger fs-1 mb-3"></i>
                <h5 class="fw-bold">@(isPt ? "Excluir Cartão?" : "Delete Card?")</h5>
                <p class="text-muted small">@(isPt ? "Esta ação só é permitida se o cartão não possuir lançamentos vinculados." : "This can only be done if the card has no linked transactions.")</p>
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">@(isPt ? "Cancelar" : "Cancel")</button>
                        <button type="submit" class="btn btn-danger">@(isPt ? "Sim, Excluir" : "Yes, Delete")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}