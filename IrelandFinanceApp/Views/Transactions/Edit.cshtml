@using Microsoft.AspNetCore.Identity
@using IrelandFinanceApp.Models.Enums
@inject UserManager<ApplicationUser> UserManager
@model IrelandFinanceApp.Models.Transaction

@{
    var isPt = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("pt", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isPt ? "Editar Lançamento" : "Edit Transaction";

    var currentUser = await UserManager.GetUserAsync(User);
    var currencySymbol = currentUser?.CurrencySymbol ?? "€";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 16px;">
        <!-- Cabeçalho -->
        <div class="d-flex align-items-center gap-2 mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0">
                    @(isPt ? "Editar Lançamento" : "Edit Transaction")
                </h4>
                <p class="text-muted small mb-0">
                    @(isPt ? "Altere os dados da movimentação financeira" : "Update your financial record details")
                </p>
            </div>
        </div>

        @if (Model.SavingsGoalId.HasValue)
        {
            <div class="alert alert-info py-2 px-3 small border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                <div>
                    @(isPt
                        ? "Este lançamento está vinculado a uma Meta de Poupança. Alterar o valor atualizará o saldo da meta automaticamente."
                        : "This transaction is linked to a Savings Goal. Changing its amount will update the goal's balance automatically.")
                </div>
            </div>
        }

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- Campos Ocultos Essenciais -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SavingsGoalId" />

            <!-- Tipo de Movimentação (Receita / Despesa) -->
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark small">@(isPt ? "Tipo de Movimentação" : "Transaction Type")</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Type" value="@TransactionType.Expense" id="typeExpense" />
                        <label class="form-check-label text-danger fw-semibold" for="typeExpense" style="cursor: pointer;">
                            <i class="bi bi-arrow-down-circle me-1"></i>@(isPt ? "Despesa" : "Expense")
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Type" value="@TransactionType.Income" id="typeIncome" />
                        <label class="form-check-label text-success fw-semibold" for="typeIncome" style="cursor: pointer;">
                            <i class="bi bi-arrow-up-circle me-1"></i>@(isPt ? "Receita" : "Income")
                        </label>
                    </div>
                </div>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>

            <!-- Descrição -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold text-dark small">@(isPt ? "Descrição" : "Description")</label>
                <input asp-for="Description" class="form-control" placeholder="@(isPt ? "Ex: Compras no Supermercado" : "e.g. Groceries")" required />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Valor -->
            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold text-dark small">@(isPt ? "Valor" : "Amount")</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted">@currencySymbol</span>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <!-- Categoria -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="CategoryId" class="form-label fw-semibold text-dark small mb-0">@(isPt ? "Categoria" : "Category")</label>
                    <a asp-controller="Categories" asp-action="Create" class="small text-decoration-none text-success">
                        + @(isPt ? "Nova Categoria" : "New Category")
                    </a>
                </div>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                    <option value="">@(isPt ? "-- Selecione uma Categoria --" : "-- Select a Category --")</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <!-- Data -->
            <div class="mb-4">
                <label asp-for="Date" class="form-label fw-semibold text-dark small">@(isPt ? "Data" : "Date")</label>
                <input asp-for="Date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    @(isPt ? "Cancelar" : "Cancel")
                </a>
                <button type="submit" class="btn btn-emerald px-4 shadow-sm">
                    <i class="bi bi-check2 me-1"></i>@(isPt ? "Salvar Alterações" : "Save Changes")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}