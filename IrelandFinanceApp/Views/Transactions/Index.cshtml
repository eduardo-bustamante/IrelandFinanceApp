@using Microsoft.AspNetCore.Identity
@using IrelandFinanceApp.Models.Enums
@inject UserManager<ApplicationUser> UserManager
@model IrelandFinanceApp.Models.ViewModels.TransactionFilterViewModel

@{
    var isPt = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("pt", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isPt ? "Lançamentos" : "Transactions";
    var currentUser = await UserManager.GetUserAsync(User);
    var currencySymbol = currentUser?.CurrencySymbol ?? "€";
}

<div class="container py-4">
    <!-- Cabeçalho -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">@(isPt ? "Lançamentos Financeiros" : "Transactions")</h3>
            <p class="text-muted small mb-0">@(isPt ? "Histórico de despesas em caixa e compras no cartão" : "Record of cashflow expenses and credit card purchases")</p>
        </div>
        <a asp-action="Create" class="btn btn-emerald px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>@(isPt ? "Novo Lançamento" : "New Transaction")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Barra de Filtros -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white" style="border-radius: 16px;">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">@(isPt ? "Buscar" : "Search")</label>
                <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="@(isPt ? "Ex: Mercado, Aluguel..." : "e.g. Rent, Grocery...")" value="@Model.SearchTerm" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">@(isPt ? "Data Início" : "Start Date")</label>
                <input type="date" name="StartDate" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">@(isPt ? "Data Fim" : "End Date")</label>
                <input type="date" name="EndDate" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">@(isPt ? "Categoria" : "Category")</label>
                <select name="CategoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories">
                    <option value="">@(isPt ? "Todas as Categorias" : "All Categories")</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-emerald flex-grow-1">
                    <i class="bi bi-filter me-1"></i>@(isPt ? "Filtrar" : "Filter")
                </button>
                <a asp-action="Index" class="btn btn-sm btn-light border text-muted">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Tabela de Lançamentos -->
    <div class="card border-0 shadow-sm bg-white" style="border-radius: 16px; overflow: hidden;">
        @if (!Model.Transactions.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                @(isPt ? "Nenhum lançamento encontrado para os filtros selecionados." : "No transactions found.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 0.8rem; text-transform: uppercase;">
                            <th class="ps-4">@(isPt ? "Data" : "Date")</th>
                            <th>@(isPt ? "Descrição" : "Description")</th>
                            <th>@(isPt ? "Categoria" : "Category")</th>
                            <th>@(isPt ? "Pagamento" : "Method")</th>
                            <th class="text-end">@(isPt ? "Valor" : "Amount")</th>
                            <th class="text-end pe-4">@(isPt ? "Ações" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Transactions)
                        {
                            var isExpense = item.Type == TransactionType.Expense;
                            var isCredit = item.PaymentMethod == PaymentMethod.CreditCard;

                            <tr>
                                <td class="ps-4 text-muted small">@item.Date.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Description</div>
                                    @if (item.IsInvoicePayment)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary" style="font-size: 0.68rem;">
                                            <i class="bi bi-check-all me-1"></i>@(isPt ? "Quitação de Fatura" : "Invoice Payoff")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Category?.Name ?? "-")
                                    </span>
                                </td>
                                <td>
                                    @if (isCredit)
                                    {
                                        <span class="badge bg-light text-primary border border-primary-subtle">
                                            <i class="bi bi-credit-card-2-front me-1"></i>
                                            @(item.CreditCard?.Name ?? "Cartão") 
                                            (@item.InvoiceMonth:D2/@item.InvoiceYear)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-success border border-success-subtle">
                                            <i class="bi bi-wallet2 me-1"></i>@(isPt ? "Caixa / Débito" : "Cash / Debit")
                                        </span>
                                    }
                                </td>
                                <td class="text-end fw-bold @(isExpense ? "text-danger" : "text-success")">
                                    @(isExpense ? "-" : "+") @currencySymbol @item.Amount.ToString("N2")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-muted border py-1 px-2">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('@(isPt ? "Tem certeza que deseja excluir?" : "Are you sure you want to delete?")');">
                                            <button type="submit" class="btn btn-sm btn-light text-danger border py-1 px-2">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>