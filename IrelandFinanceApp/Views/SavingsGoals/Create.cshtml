@model IrelandFinanceApp.Models.SavingsGoal

@{
    ViewData["Title"] = "Nova Meta";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-dark mb-1">Nova Meta Financeira</h4>
        <p class="text-muted small mb-4">Defina o valor alvo e a data limite para o seu objetivo.</p>

        <form asp-action="Create" method="post">
            <!-- EXIBE QUALQUER ERRO DE VALIDAÇÃO OU BANCO -->
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label small fw-semibold text-secondary">Nome da Meta</label>
                <input asp-for="Name" class="form-control" placeholder="Ex: Reserva de Emergência, Viagem, etc." required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="TargetAmount" class="form-label small fw-semibold text-secondary">Valor Alvo</label>
                    <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" min="1" placeholder="0,00" required />
                    <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CurrentAmount" class="form-label small fw-semibold text-secondary">Valor Inicial Já Guardado</label>
                    <input asp-for="CurrentAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0,00" value="0" />
                    <span asp-validation-for="CurrentAmount" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="TargetDate" class="form-label small fw-semibold text-secondary">Data Limite / Alvo</label>
                <input asp-for="TargetDate" class="form-control" type="date" required />
                <span asp-validation-for="TargetDate" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white rounded-pill px-4 fw-semibold" style="background-color: #10b981;">
                    <i class="bi bi-check2 me-1"></i> Criar Meta
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}