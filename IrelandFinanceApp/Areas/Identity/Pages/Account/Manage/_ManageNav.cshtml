@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
}

<div class="nav flex-column nav-pills gap-1">
    <a class="nav-link manage-pill @(currentPath.EndsWith("/Manage") || currentPath.EndsWith("/Manage/Index") ? "active" : "")" id="profile" asp-page="./Index">
        <i class="bi bi-person-gear me-2"></i> Perfil
    </a>
    <a class="nav-link manage-pill @(currentPath.EndsWith("/Preferences") ? "active" : "")" id="preferences" asp-page="./Preferences">
        <i class="bi bi-globe2 me-2"></i> Preferências Regionais
    </a>
    <a class="nav-link manage-pill @(currentPath.EndsWith("/Email") ? "active" : "")" id="email" asp-page="./Email">
        <i class="bi bi-envelope me-2"></i> E-mail
    </a>
    <a class="nav-link manage-pill @(currentPath.EndsWith("/ChangePassword") ? "active" : "")" id="change-password" asp-page="./ChangePassword">
        <i class="bi bi-shield-lock me-2"></i> Senha
    </a>
    @if (hasExternalLogins)
    {
        <a id="external-login" class="nav-link manage-pill @(currentPath.EndsWith("/ExternalLogins") ? "active" : "")" asp-page="./ExternalLogins">
            <i class="bi bi-box-arrow-up-right me-2"></i> Logins Externos
        </a>
    }
    <a class="nav-link manage-pill @(currentPath.EndsWith("/TwoFactorAuthentication") ? "active" : "")" id="two-factor-authentication" asp-page="./TwoFactorAuthentication">
        <i class="bi bi-phone me-2"></i> Autenticação 2FA
    </a>
    <a class="nav-link manage-pill @(currentPath.EndsWith("/PersonalData") ? "active" : "")" id="personal-data" asp-page="./PersonalData">
        <i class="bi bi-database-lock me-2"></i> Dados Pessoais
    </a>
</div>

<style>
    .manage-pill {
        color: #475569 !important;
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.65rem 1rem;
        border-radius: 8px;
        transition: all 0.15s ease-in-out;
        display: flex;
        align-items: center;
        text-decoration: none;
    }
    .manage-pill:hover {
        background-color: #f1f5f9;
        color: #0f172a !important;
    }
    .manage-pill.active {
        background-color: #10b981 !important;
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }
    .manage-pill.active i {
        color: #ffffff !important;
    }
</style>