@page
@model Microsoft.AspNetCore.Identity.UI.V4.Pages.Account.Manage.Internal.ChangePasswordModel
@{
    ViewData["Title"] = "Senha";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="fw-bold text-dark mb-0">Alterar Senha</h5>
        <p class="text-muted small mb-0">Mantenha sua conta segura utilizando senhas fortes com números e caracteres especiais.</p>
    </div>
    <span class="badge px-3 py-2 rounded-pill bg-light text-secondary border">
        <i class="bi bi-key me-1"></i> Credenciais
    </span>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Input.OldPassword" class="form-label small fw-semibold text-secondary">Senha Atual</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" type="password" />
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label small fw-semibold text-secondary">Nova Senha</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-plus"></i></span>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" type="password" />
        </div>
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label small fw-semibold text-secondary">Confirmar Nova Senha</label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-check"></i></span>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" type="password" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="pt-3 border-top d-flex justify-content-end">
        <button type="submit" class="btn text-white px-4 py-2 fw-semibold shadow-sm" style="background-color: #10b981; border-radius: 8px;">
            <i class="bi bi-check2 me-1"></i> Atualizar Senha
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}