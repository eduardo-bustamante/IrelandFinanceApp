@page
@model IrelandFinanceApp.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Perfil";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="fw-bold text-dark mb-0">Dados do Perfil</h5>
        <p class="text-muted small mb-0">Informações pessoais e dados de contato associados à conta.</p>
    </div>
    <span class="badge px-3 py-2 rounded-pill" style="font-size: 0.78rem; background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
        <i class="bi bi-shield-check me-1"></i> Verificado
    </span>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Input.FullName" class="form-label small fw-semibold text-secondary">Nome Completo</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
                <input asp-for="Input.FullName" class="form-control" placeholder="Seu nome" />
            </div>
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Username" class="form-label small fw-semibold text-secondary">Nome de Usuário</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-at"></i></span>
                <input asp-for="Username" class="form-control bg-light text-muted" disabled readonly style="cursor: not-allowed;" />
            </div>
        </div>

        <div class="col-12">
            <label asp-for="Input.PhoneNumber" class="form-label small fw-semibold text-secondary">Telefone de Contato</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-telephone"></i></span>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+353 ... ou (xx) xxxxx-xxxx" />
            </div>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
        </div>
    </div>

    <div class="pt-3 border-top d-flex justify-content-end">
        <button id="update-profile-button" type="submit" class="btn text-white px-4 py-2 fw-semibold shadow-sm" style="background-color: #10b981; border-radius: 8px;">
            <i class="bi bi-check2 me-1"></i> Salvar Alterações
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}