@page
@model IrelandFinanceApp.Areas.Identity.Pages.Account.Manage.PreferencesModel
@{
    ViewData["Title"] = "Preferências Regionais";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h5 class="fw-bold text-dark mb-0">Idioma, Moeda e Fuso Horário</h5>
        <p class="text-muted small mb-0">Defina o padrão de exibição numérica, datas e apuração de faturas.</p>
    </div>
    <span class="badge px-3 py-2 rounded-pill" style="font-size: 0.78rem; background: rgba(16, 185, 129, 0.12); color: #059669; font-weight: 600;">
        <i class="bi bi-globe me-1"></i> Regional
    </span>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="post" class="mt-4">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Input.CultureCode" class="form-label small fw-semibold text-secondary">Idioma e Formatação</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-translate"></i></span>
                <select asp-for="Input.CultureCode" class="form-select">
                    <option value="en-IE">Inglês (Irlanda) - en-IE</option>
                    <option value="pt-BR">Português (Brasil) - pt-BR</option>
                    <option value="en-US">Inglês (EUA) - en-US</option>
                </select>
            </div>
            <div class="form-text small text-muted">Ajusta textos do sistema e formato de datas.</div>
            <span asp-validation-for="Input.CultureCode" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Input.CurrencySymbol" class="form-label small fw-semibold text-secondary">Moeda Padrão</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-cash-stack"></i></span>
                <select asp-for="Input.CurrencySymbol" class="form-select">
                    <option value="€">Euro (€)</option>
                    <option value="R$">Real Brasileiro (R$)</option>
                    <option value="$">Dólar ($)</option>
                    <option value="£">Libra Esterlina (£)</option>
                </select>
            </div>
            <div class="form-text small text-muted">Símbolo exibido nos cards do dashboard e relatórios.</div>
            <span asp-validation-for="Input.CurrencySymbol" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Input.TimeZoneId" class="form-label small fw-semibold text-secondary">Fuso Horário</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-clock"></i></span>
                <select asp-for="Input.TimeZoneId" class="form-select">
                    <option value="Europe/Dublin">Dublin / Londres (GMT / IST)</option>
                    <option value="America/Sao_Paulo">Brasília / São Paulo (GMT-3)</option>
                    <option value="America/New_York">Nova York (EST / EDT)</option>
                    <option value="UTC">UTC Universal</option>
                </select>
            </div>
            <div class="form-text small text-muted">Usado no cálculo exato de fechamento de cartões e faturas.</div>
            <span asp-validation-for="Input.TimeZoneId" class="text-danger small"></span>
        </div>
    </div>

    <div class="pt-3 border-top d-flex justify-content-end">
        <button type="submit" class="btn text-white px-4 py-2 fw-semibold shadow-sm" style="background-color: #10b981; border-radius: 8px;">
            <i class="bi bi-check2 me-1"></i> Salvar Preferências
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}